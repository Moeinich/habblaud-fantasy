# Minimal build context: everything is left out except what the build needs.
# (Keeps node_modules, dist, art generation caches and local files away from the daemon.)
*
!package.json
!package-lock.json
!tsconfig.json
!vite.config.ts
!client/
!shared/
!server/
!scripts/build-server.mjs
!scripts/ingest-token.ts

# Even inside the included folders: no local clutter.
**/node_modules
**/.DS_Store
**/*.log
